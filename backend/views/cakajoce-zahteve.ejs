<!DOCTYPE html>
<html lang="sl">
<head>
  <meta charset="UTF-8">
  <title>Čakajoče zahteve - SuperTutor</title>
</head>
<body>
  <h1>Čakajoče zahteve</h1>
  <p><a href="/odjava">Odjava</a></p>

  <% if (obvestila.length > 0) { %>
    <div style="background: #ffeeba; padding: 10px;">
      <h3>Nova obvestila</h3>
      <ul>
        <% obvestila.forEach(o => { %>
          <li><%= o.besedilo %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (zahteve.length === 0) { %>
    <p>Trenutno ni čakajočih zahtev.</p>
  <% } %>

  <ul>
    <% zahteve.forEach(z => { %>
      <li>
        <strong><%= z.datum %>, <%= z.zacetek %>–<%= z.konec %></strong><br>
        Študent: <%= z.student_ime %> <%= z.student_priimek %><br>
        Predmet: <%= z.predmet_naziv %><br>
        Teme: <%= z.teme %><br>
        Način izvedbe: <%= z.nacin_izvedbe %> (<%= z.lokacija_kontakt %>)<br>

        <form method="POST" action="/tutor/zahteve/<%= z.id %>/potrdi" style="display:inline;">
          <button type="submit">Potrdi</button>
        </form>
        <form method="POST" action="/tutor/zahteve/<%= z.id %>/zavrni" style="display:inline;">
          <button type="submit">Zavrni</button>
        </form>
      </li>
      <hr>
    <% }) %>
  </ul>

  <!DOCTYPE html>
