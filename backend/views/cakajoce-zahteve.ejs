  <h2>Potrjeni termini</h2>
<% if (potrjeniTermini.length === 0) { %>
  <p>Trenutno nimaš potrjenih terminov.</p>
<% } else { %>
  <ul>
    <% potrjeniTermini.forEach(t => { %>
      <li>
        <%= t.datum %>, <%= t.zacetek %>–<%= t.konec %> - <%= t.predmet_naziv %>
        (<%= t.student_ime %> <%= t.student_priimek %>)
        <a href="/tutor/priprava/<%= t.id %>">Priprava / Zapiski</a>
      </li>
    <% }) %>
  </ul>
<% } %>
</body>
</html>
</body>
</html>