<!DOCTYPE html>
<html lang="sl">
<head>
  <meta charset="UTF-8">
  <title>Registracija - SuperTutor</title>
</head>
<body>
  <h1>Registracija</h1>

  <% if (napaka) { %>
    <p style="color: red;"><%= napaka %></p>
  <% } %>

  <form method="POST" action="/registracija">
    <label>Ime: <input type="text" name="ime" value="<%= podatki.ime || '' %>" required></label><br>
    <label>Priimek: <input type="text" name="priimek" value="<%= podatki.priimek || '' %>" required></label><br>
    <label>E-pošta: <input type="email" name="email" value="<%= podatki.email || '' %>" required></label><br>
    <label>Geslo: <input type="password" name="geslo" required></label><br>
    <label>Potrdi geslo: <input type="password" name="geslo2" required></label><br>
    <label>Smer študija:
      <select name="smer" required>
        <option value="">-- izberi --</option>
        <option value="Telekomunikacije" <%= podatki.smer === 'Telekomunikacije' ? 'selected' : '' %>>Telekomunikacije</option>
        <option value="Računalništvo in informatika" <%= podatki.smer === 'Računalništvo in informatika' ? 'selected' : '' %>>Računalništvo in informatika</option>
        <option value="Elektrotehnika" <%= podatki.smer === 'Elektrotehnika' ? 'selected' : '' %>>Elektrotehnika</option>
      </select>
    </label><br>
    <button type="submit">Registriraj se</button>
  </form>
</body>
</html>