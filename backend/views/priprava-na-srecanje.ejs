<!DOCTYPE html>
<html lang="sl">
<head>
  <meta charset="UTF-8">
  <title>Priprava na srečanje - SuperTutor</title>
</head>
<body>
  <h1>Priprava na srečanje</h1>
  <p><a href="/tutor/zahteve">Nazaj</a></p>

  <p><strong>Datum:</strong> <%= termin.datum %>, <%= termin.zacetek %>–<%= termin.konec %></p>
  <p><strong>Študent:</strong> <%= termin.student_ime %> <%= termin.student_priimek %></p>
  <p><strong>Predmet:</strong> <%= termin.predmet_naziv %></p>
  <p><strong>Teme:</strong> <%= termin.teme %></p>

  <h2>Prejšnji zapiski za tega študenta</h2>
  <% if (zapiski.length === 0) { %>
    <p>Ni prejšnjih zapiskov.</p>
  <% } else { %>
    <ul>
      <% zapiski.forEach(z => { %>
        <li><%= z.ustvarjeno_ob %>: <%= z.besedilo %></li>
      <% }) %>
    </ul>
  <% } %>

  <% if (preteklo) { %>
    <h2>Dodaj zapisek</h2>
    <form method="POST" action="/tutor/priprava/<%= termin.id %>/zapisek">
      <textarea name="besedilo" rows="5" cols="40" required placeholder="Kako se študent najbolje uči, kaj mu pomaga, na čem delati naslednjič..."></textarea><br>
      <button type="submit">Shrani zapisek</button>
    </form>
  <% } else { %>
    <p><em>Zapisek bo mogoče dodati po tem, ko termin mine.</em></p>
  <% } %>
</body>
</html>